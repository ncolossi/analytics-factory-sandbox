config {
  type: "incremental",
  schema: "bronze_ons_infraestrutura_sistema",
  name: "linha_transmissao",
  description: "Cópia bruta e materializada de linhas de transmissão do ONS, preservada sem transformação (append-only).",
  bigquery: { partitionBy: "DATE(_ingestion_timestamp)" },
  tags: ["bronze", "ons_infraestrutura_sistema", "incremental"],
  columns: {
    _ingestion_timestamp: "Timestamp UTC da ingestão e materialização da tabela na camada bronze.",
    _source_file: "Caminho do recurso GCP (tabela BigQuery) de origem dos dados.",
    _batch_id: "Identificador único do lote (batch) de carga baseado em timestamp.",
    id_subsistema_terminalde: "Subsistema da subestação do terminal DE da linha de transmissão.",
    nom_subsistema_terminalde: "Nome do subsistema da subestação do terminal DE da linha de transmissão.",
    id_subsistema_terminalpara: "Subsistema da subestação do terminal PARA da linha de transmissão. O conteúdo NULL (ou vazio) refere-se a ramais (ou taps de linha).",
    nom_subsistema_terminalpara: "Nome do subsistema da subestação do terminal PARA da linha de transmissão. O conteúdo NULL (ou vazio) refere-se a ramais (ou taps de linha).",
    id_estado_terminalde: "Estado da subestação do terminal DE da linha de transmissão.",
    nom_estado_de: "Nome do estado da subestação do terminal DE da linha de transmissão.",
    id_estado_terminalpara: "Estado da subestação do terminal PARA da linha de transmissão. O conteúdo NULL (ou vazio) refere-se a ramais (ou taps de linha).",
    nom_estado_para: "Nome do estado da subestação do terminal PARA da linha de transmissão.",
    nom_subestacao_de: "Nome da subestação do terminal DE da linha de transmissão.",
    nom_subestacao_para: "Nome da subestação do terminal PARA da linha de transmissão. O conteúdo NULL (ou vazio) refere-se a ramais (ou taps de linha).",
    val_niveltensao_kv: "Nível de tensão nominal da linha de transmissão, em kV.",
    nom_tipoderede: "Nome do tipo de rede da linha de transmissão.",
    nom_tipolinha: "Tipo da linha (AC, DC ou ramal de linha).",
    nom_agenteproprietario: "Nome do agente proprietário da linha de transmissão.",
    nom_linhadetransmissao: "Nome da linha de transmissão.",
    cod_equipamento: "Código do Equipamento - Unidade Geradora.",
    dat_entradaoperacao: "Data de liberação da linha de transmissão para operação do ONS.",
    dat_desativacao: "Data de desativação da linha de transmissão. O motivo mais comum para a desativação de uma linha de transmissão é o seccionamento.",
    dat_prevista: "Data prevista de entrada em operação da linha de transmissão.",
    val_comprimento: "Comprimento da linha de transmissão, em km.",
    val_resistencia: "Resistência de sequência positiva.",
    val_reatancia: "Reatância de sequência positiva.",
    val_shunt: "Susceptância de sequência positiva (SHUNT).",
    val_capacoperlongasemlimit: "Capacidade Operativa de Longa duração contratada no CPST, SEM fator Limitante, em ampere.",
    val_capacoperlongacomlimit: "Capacidade Operativa de Longa duração contratada no CPST, COM fator Limitante, em ampere.",
    val_capacopercurtasemlimit: "Capacidade Operativa de Curta duração contratada no CPST, SEM Limitação, em ampere.",
    val_capacopercurtacomlimit: "Capacidade Operativa de Curta duração contratada no CPST, COM Limitação, em ampere.",
    val_capacidadeoperveraodialonga: "Capacidade Operativa Sazonal (Verão Dia-VD) em Regime de Longa Duração (LD).",
    val_capacidadeoperveraonoitelonga: "Capacidade Operativa Sazonal (Verão Noite-VN) em Regime de Longa Duração (LD).",
    val_capacoperinvernodialonga: "Capacidade Operativa Sazonal (Inverno Dia-ID) em Regime de Longa Duração (LD).",
    val_capacoperinvernonoitelonga: "Capacidade Operativa Sazonal (Inverno Noite-IN) em Regime de Longa Duração (LD).",
    val_capacoperveradiacurta: "Capacidade Operativa Sazonal (Verão Dia-VD) em Regime de Curta Duração (CD).",
    val_capacoperveraonoitecurta: "Capacidade Operativa Sazonal (Verão Noite-VN) em Regime de Curta Duração (CD).",
    val_capacoperinvernodiacurta: "Capacidade Operativa Sazonal (Inverno Dia-ID) em Regime de Curta Duração (CD).",
    val_capacoperinvernonoitecurta: "Capacidade Operativa Sazonal (Inverno Noite-IN) em Regime de Curta Duração (CD).",
    num_barra_de: "Número do Barramento De.",
    num_barra_para: "Número do Barramento Para.",
    dt: "Data da partição (fallback Hive).",
    row_hash: "Hash para deduplicação (FARM_FINGERPRINT)."
  }
}

SELECT
  CURRENT_TIMESTAMP() AS _ingestion_timestamp,
  'projects/cymbal-data-platform-dev/datasets/ons_infraestrutura_sistema/tables/linha_transmissao' AS _source_file,
  FORMAT_TIMESTAMP('%Y%m%d%H%M%S', CURRENT_TIMESTAMP()) AS _batch_id,
  id_subsistema_terminalde,
  nom_subsistema_terminalde,
  id_subsistema_terminalpara,
  nom_subsistema_terminalpara,
  id_estado_terminalde,
  nom_estado_de,
  id_estado_terminalpara,
  nom_estado_para,
  nom_subestacao_de,
  nom_subestacao_para,
  val_niveltensao_kv,
  nom_tipoderede,
  nom_tipolinha,
  nom_agenteproprietario,
  nom_linhadetransmissao,
  cod_equipamento,
  dat_entradaoperacao,
  dat_desativacao,
  dat_prevista,
  val_comprimento,
  val_resistencia,
  val_reatancia,
  val_shunt,
  val_capacoperlongasemlimit,
  val_capacoperlongacomlimit,
  val_capacopercurtasemlimit,
  val_capacopercurtacomlimit,
  val_capacidadeoperveraodialonga,
  val_capacidadeoperveraonoitelonga,
  val_capacoperinvernodialonga,
  val_capacoperinvernonoitelonga,
  val_capacoperveradiacurta,
  val_capacoperveraonoitecurta,
  val_capacoperinvernodiacurta,
  val_capacoperinvernonoitecurta,
  num_barra_de,
  num_barra_para,
  dt,
  row_hash
FROM ${ref("ons_infraestrutura_sistema", "linha_transmissao")}
${when(incremental(), `WHERE dt > (SELECT MAX(dt) FROM ${self()})`)}
